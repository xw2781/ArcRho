[sqlfluff]
dialect = tsql
templater = raw
rules = LT01,LT02,LT03,LT04,LT06,LT07,LT08,LT09,LT10,LT11,LT12,LT13,LT14,LT15,CP01,CP04
max_line_length = 120
fix_even_unparsable = False
processes = 1
large_file_skip_byte_limit = 0

[sqlfluff:indentation]
indent_unit = space
tab_space_size = 4
indented_joins = False
indented_using_on = True
indented_on_contents = True
implicit_indents = allow
template_blocks_indent = True

[sqlfluff:layout:type:comma]
line_position = trailing

[sqlfluff:layout:type:set_operator]
line_position = alone:strict

[sqlfluff:layout:type:when_clause]
keyword_line_position = leading

[sqlfluff:layout:type:else_clause]
keyword_line_position = leading

[sqlfluff:layout:type:join_clause]
keyword_line_position = leading

[sqlfluff:layout:type:join_on_condition]
keyword_line_position = leading

[sqlfluff:layout:type:begin_end_block]
keyword_line_position = leading

[sqlfluff:layout:type:if_then_statement]
keyword_line_position = leading

[sqlfluff:layout:type:set_segment]
keyword_line_position = leading

[sqlfluff:layout:type:set_local_variable_segment]
keyword_line_position = leading

[sqlfluff:layout:type:declare_segment]
keyword_line_position = leading

[sqlfluff:layout:type:throw_statement]
keyword_line_position = leading

[sqlfluff:layout:type:transaction_statement]
keyword_line_position = leading

[sqlfluff:layout:type:update_statement]
keyword_line_position = leading

[sqlfluff:layout:type:insert_statement]
keyword_line_position = leading

[sqlfluff:rules:capitalisation.keywords]
capitalisation_policy = upper

[sqlfluff:rules:capitalisation.literals]
capitalisation_policy = upper

[sqlfluff:rules:layout.select_targets]
wildcard_policy = single
